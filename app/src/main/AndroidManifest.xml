<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false" />

    <application
        android:name=".PhoneLmApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Android 12+ native-library namespace declaration. Qualcomm devices
             normally expose this library; required=false keeps CPU/Vulkan usable
             when a vendor does not. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <!-- QNN HTP's architecture-specific transport stub has a DT_NEEDED
             dependency on Qualcomm's vendor FastRPC client library. Declaring
             it exposes the device-provided library to the app linker namespace. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".LiveUpdateDismissReceiver" android:exported="false" />
    </application>

</manifest>
